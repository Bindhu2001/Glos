{
  "expo": {
    "name": "Glos",
    "slug": "glos",
    "scheme": "com.greatleap.glos",
    "privacy": "public",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.greatleap.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1a56db"
      },
      "package": "com.greatleap.glos",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize",
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "minSdkVersion": 21
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to upload a logo."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "privacyPolicyUrl": "https://mypayrollmaster.online/Glos-privacypolicy.html",
    "owner": "athiraks",
    "extra": {
      "eas": {
        "projectId": "04eaec98-29d5-4cb3-99dc-c4c4f80b9f3a"
      }
    }
  }
}
