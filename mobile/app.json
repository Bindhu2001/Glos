{
  "expo": {
    "name": "Glos",
    "slug": "glos",
    "scheme": "com.greatleap.glos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.greatleap.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1a56db"
      },
      "package": "com.greatleap.glos",
      "versionCode": 5,
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to update your profile picture."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21",
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone to record voice messages."
        }
      ],
      "expo-asset",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification_icon.png",
          "color": "#1a56db"
        }
      ]
    ],
    "owner": "athiraks",
    "extra": {
      "privacyPolicyUrl": "https://glosonline.com/privacy-policy.html",
      "eas": {
        "projectId": "04eaec98-29d5-4cb3-99dc-c4c4f80b9f3a"
      }
    }
  }
}
